<?xml version="1.0" encoding="utf-8"?>
<!-- Віджет 1×1 без монети: пунктирне коло з «+», як «+» серед монет на головній -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="72dp"
        android:height="72dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/muted"
                android:dashWidth="5dp"
                android:dashGap="4dp" />
        </shape>
    </item>
    <item
        android:width="30dp"
        android:height="30dp"
        android:gravity="center">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:pathData="M12 5 V19 M5 12 H19"
                android:strokeColor="@color/muted"
                android:strokeLineCap="round"
                android:strokeWidth="2" />
        </vector>
    </item>
</layer-list>
