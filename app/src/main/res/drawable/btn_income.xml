<?xml version="1.0" encoding="utf-8"?>
<!-- Обвідка: світле тло кнопки майже не відрізняється від тла віджета -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="24dp"
        android:height="24dp">
        <shape android:shape="oval">
            <solid android:color="@color/inc_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/inc_text" />
        </shape>
    </item>
    <item
        android:width="14dp"
        android:height="14dp"
        android:drawable="@drawable/ic_plus"
        android:gravity="center" />
</layer-list>
