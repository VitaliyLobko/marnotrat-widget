<?xml version="1.0" encoding="utf-8"?>
<!-- Шрифти — як у шапці Марнотрату: числа medium (500) з табличними цифрами; висота в dp — щоб autoSize зменшував шрифт, а не обрізав число -->
<resources>
    <style name="WidgetLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:autoSizeMaxTextSize">11sp</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetHero">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:autoSizeMaxTextSize">30sp</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">—</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="WidgetHero.Compact">
        <item name="android:layout_height">32dp</item>
        <item name="android:autoSizeMaxTextSize">26sp</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="WidgetHero.Second">
        <item name="android:autoSizeMaxTextSize">22sp</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:textColor">@color/brand_text</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="WidgetRowKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">—</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="WidgetNote">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Коло менше за зону натискання: fitCenter вписує малюнок у простір між відступами -->
    <style name="WidgetButton">
        <item name="android:background">@drawable/btn_press</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="WidgetButton.Compact">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="WidgetButton.Large">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">4dp</item>
    </style>
</resources>
