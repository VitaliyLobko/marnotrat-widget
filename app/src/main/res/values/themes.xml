<?xml version="1.0" encoding="utf-8"?>
<!-- Екрани застосунку без системної шапки: свій заголовок, тло й рядок стану як у Марнотраті -->
<resources>
    <style name="Theme.Marnotrat" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>
</resources>
