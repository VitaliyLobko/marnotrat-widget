<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/period"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/refresh"
            android:padding="5dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hero_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/brand_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hero_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/add_expense"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_brand"
            android:contentDescription="@string/add_expense"
            android:padding="10dp"
            android:src="@drawable/ic_minus"
            android:tint="@color/on_brand" />

        <ImageView
            android:id="@+id/add_income"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_income"
            android:contentDescription="@string/add_income"
            android:padding="10dp"
            android:src="@drawable/ic_plus"
            android:tint="@color/inc_text" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bars"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp">

        <ProgressBar
            android:id="@+id/bar_ok"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="1000"
            android:progressDrawable="@drawable/bar_ok" />

        <ProgressBar
            android:id="@+id/bar_over"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="1000"
            android:progressDrawable="@drawable/bar_over"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tile_bg"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/today"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/today_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/tile_bg"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/balance"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/bal_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/tile_bg"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/plan_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/planned"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/plan_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
